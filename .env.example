# Copy this file to .env and fill in real values

NODE_ENV=development
PORT=5001

# Local Docker MongoDB (default for dev)
MONGODB_URI=mongodb://eventoadmin:eventopassword@localhost:27017/evento_db?authSource=admin

# Mongo Docker credentials (used by docker-compose)
MONGO_ROOT_USERNAME=eventoadmin
MONGO_ROOT_PASSWORD=eventopassword

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=30m

# Client API URL
VITE_API_URL=http://localhost:5001/api

# Stripe (test keys)
STRIPE_PUBLIC_KEY=pk_test_your_test_public_key
STRIPE_SECRET_KEY=sk_test_your_test_secret_key
